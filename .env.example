# Environment Variables for Blockchain Development

# Sepolia Testnet RPC URL (Get from Alchemy or Infura)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=

# Deployer Private Key (DO NOT SHARE - For testnet only)
# Export from MetaMask: Account Details > Export Private Key
DEPLOYER_PRIVATE_KEY=

# Etherscan API Key (For contract verification)
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Gemini API Key (Existing)
GEMINI_API_KEY=

# Optional: IPFS/Pinata (For decentralized file storage)
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_KEY=

# Deployed Contract Addresses (Auto-populated by deployment script)
VITE_KYC_CONTRACT_ADDRESS=
VITE_MARKETPLACE_CONTRACT_ADDRESS=
VITE_ESCROW_CONTRACT_ADDRESS=
